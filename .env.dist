# See docs/env.md for descriptions. Copy to .env and fill in.

# Local domain Postgres (Drizzle). Start with: npm run db:up
DATABASE_URL=postgresql://cartonium:cartonium@localhost:5432/cartonium
POSTGRES_USER=cartonium
POSTGRES_PASSWORD=cartonium
POSTGRES_DB=cartonium
POSTGRES_PORT=5432

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public origin used by Better Auth + Telegram widget (HTTPS tunnel in local TG login)
BETTER_AUTH_URL=http://localhost
NUXT_PUBLIC_SITE_URL=http://localhost
# Optional comma-separated extra origins
# BETTER_AUTH_TRUSTED_ORIGINS=https://abc.ngrok-free.app

# Telegram Login Widget
NUXT_BOT_TOKEN=telegram-bot-token
NUXT_PUBLIC_BOT_LOGIN=your_bot_username

# Optional bots (disabled in telegram-bots-starter by default)
NUXT_BOT_BLOODBOWL_TOKEN=
NUXT_BOT_BLOODBOWL_SPREADSHEET=
NUXT_BOT_BLOODBOWL_LEAGUE=
NUXT_BOT_SCHEDULE_TOKEN=
