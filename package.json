{
  "name": "cartonium",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "devhost": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d postgres",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "npx prettier --write \"app/**/*.{ts,vue,js}\" \"server/**/*.{ts,js}\" \"shared/**/*.ts\" \"docs/**/*.md\" AGENTS.md CODE_MAP.md nuxt.config.ts vuetify.config.ts",
    "format:check": "npx prettier --check \"app/**/*.{ts,vue,js}\" \"server/**/*.{ts,js}\" \"shared/**/*.ts\" \"docs/**/*.md\" AGENTS.md CODE_MAP.md nuxt.config.ts vuetify.config.ts"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "^9.5.3",
    "dayjs-nuxt": "^2.1.11",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "nuxt": "^4.4.2",
    "nuxt-translation-manager": "^1.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^5.1.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "^2.1.6",
    "vuetify-nuxt-module": "^0.18.6"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.15",
    "@date-io/dayjs": "^2.17.0",
    "@mdi/font": "^7.3.67",
    "better-auth": "^1.7.15",
    "better-auth-telegram": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^4.2.7",
    "googleapis": "^105.0.0",
    "maska": "^2.1.11",
    "postgres": "^3.4.5",
    "quill": "^2.0.2",
    "sass": "^1.66.1",
    "type-fest": "^4.26.1",
    "typescript-telegram-bot-api": "^0.4.0"
  }
}
