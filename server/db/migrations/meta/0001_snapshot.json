          "type": "smallint",
          "primaryKey": false,
          "notNull": false
        },
        "raw_user_meta_data": {
          "name": "raw_user_meta_data",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "telegram_username": {
          "name": "telegram_username",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "full_name": {
          "name": "full_name",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "avatar_url": {
          "name": "avatar_url",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "gamebox": {
          "name": "gamebox",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        },
        "owneruser": {
          "name": "owneruser",
          "type": "jsonb",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "\n  SELECT\n    g.id,\n    g.created_at,\n    g.owner_id,\n    g.start_date,\n    g.comment_owner,\n    g.guests_max,\n    g.comment_club,\n    g.club_id,\n    g.table_id,\n    g.own_name,\n    g.gamebox_id,\n    gg.user_id,\n    gg.guests_number,\n    jsonb_build_object(\n      'full_name', p.full_name,\n      'first_name', split_part(COALESCE(p.full_name, ''), ' ', 1),\n      'avatar_url', p.avatar_url,\n      'telegram_username', p.telegram_username,\n      'picture', p.avatar_url\n    ) AS raw_user_meta_data,\n    p.telegram_username,\n    p.full_name,\n    p.avatar_url,\n    jsonb_build_object(\n      'id', gb.id,\n      'title', gb.title,\n      'photo_url', gb.photo_url,\n      'id_tesera', gb.id_tesera,\n      'id_bgg', gb.id_bgg,\n      'rating_tesera', gb.rating_tesera,\n      'rating_bgg', gb.rating_bgg,\n      'link_tesera', gb.link_tesera,\n      'link_bgg', gb.link_bgg,\n      'year', gb.year,\n      'players_min', gb.players_min,\n      'players_max', gb.players_max,\n      'players_good', gb.players_good,\n      'playtime_min', gb.playtime_min,\n      'playtime_max', gb.playtime_max,\n      'playtime_avg', gb.playtime_avg,\n      'alias_tesera', gb.alias_tesera,\n      'titles', gb.titles\n    ) AS gamebox,\n    jsonb_build_object(\n      'id', owner.id,\n      'metadata', jsonb_build_object(\n        'full_name', owner.full_name,\n        'first_name', split_part(COALESCE(owner.full_name, ''), ' ', 1),\n        'avatar_url', owner.avatar_url,\n        'telegram_username', owner.telegram_username,\n        'picture', owner.avatar_url\n      )\n    ) AS owneruser\n  FROM gatherings g\n  LEFT JOIN (\n    SELECT gathering_id, user_id, guests_number\n    FROM gatherings_guests\n    WHERE guests_number > 0\n  ) gg ON g.id = gg.gathering_id\n  LEFT JOIN profiles p ON gg.user_id = p.id\n  LEFT JOIN profiles owner ON g.owner_id = owner.id\n  LEFT JOIN gameboxes gb ON g.gamebox_id = gb.id\n  WHERE g.start_date >= (CURRENT_DATE - INTERVAL '1 day')\n",
      "name": "gatherings_with_guests",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
